generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ── Users ─────────────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  credits   Int      @default(5)
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scans              Scan[]
  bulkJobs           BulkJob[]
  creditTransactions CreditTransaction[]

  @@map("users")
}

enum Plan {
  FREE
  STARTER
  PRO
  TEAM
}

// ── Scans ─────────────────────────────────────────────────────────────────────
// Bridge traces + exit wallets are embedded in `result` (JSON) — no need for
// separate collections. MongoDB shines here.
model Scan {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?    @db.ObjectId
  address   String
  ensName   String?    // original ENS input, if resolved
  status    ScanStatus @default(PENDING)
  result    Json?      // full ScanResult document embedded
  pdfUrl    String?
  error     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@map("scans")
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

// ── Wallet Cache ───────────────────────────────────────────────────────────────
// Use a TTL index in Atlas (expiresAt field) to auto-purge stale entries.
model WalletCache {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  address   String   @unique
  data      Json
  cachedAt  DateTime @default(now())
  expiresAt DateTime

  @@map("wallet_cache")
}

// ── Bulk Jobs ──────────────────────────────────────────────────────────────────
model BulkJob {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?       @db.ObjectId
  ip        String?
  addresses String[]
  mode      String        @default("quick")
  status    BulkJobStatus @default(PENDING)
  progress  Int           @default(0)
  total     Int
  scanIds   String[]      @default([])
  reportUrl String?
  result    Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@map("bulk_jobs")
}

enum BulkJobStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

// ── Credit Transactions ────────────────────────────────────────────────────────
model CreditTransaction {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  userId    String          @db.ObjectId
  amount    Int
  type      TransactionType
  scanId    String?         @db.ObjectId
  note      String?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("credit_transactions")
}

enum TransactionType {
  PURCHASE
  USAGE
  REFUND
  BONUS
}

// ── Solana: OG finder ──────────────────────────────────────────────────────────
// Mint creation time never changes, so this is a permanent cache.
model SolMintOrigin {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  mint              String    @unique
  createdAtChain    DateTime? // blockTime of the mint's first tx
  creationSignature String?
  creationSlot      Int?
  checkedAt         DateTime  @default(now())

  @@map("sol_mint_origins")
}

// ── Solana: wallet graph (alt-wallet detection) ────────────────────────────────
model SolWalletScan {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  address   String
  status    ScanStatus @default(PENDING)
  result    Json?
  error     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([address])
  @@map("sol_wallet_scans")
}

// Every link found, kept independently of scans so identities can later be
// propagated across the graph (wallet → alt → social identity).
model WalletEdge {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  chain      String   @default("solana")
  from       String
  to         String
  signal     String   // FEE_PAYER | FUNDED_CHILD | SHARED_FUNDER | FUNDED_BY | SWEEP_OUT | SWEEP_IN
  weight     Float
  signatures String[]
  scanId     String   @db.ObjectId
  createdAt  DateTime @default(now())

  @@unique([chain, from, to, signal])
  @@index([chain, to])
  @@map("wallet_edges")
}

// CEX hot wallets, bridges, mixers, programs — never treated as alts.
model KnownEntity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  chain     String
  address   String
  label     String
  kind      String   // cex | program | bridge | mixer | relayer | other
  createdAt DateTime @default(now())

  @@unique([chain, address])
  @@map("known_entities")
}
